{
  "name": "gas-test-runner",
  "version": "1.0.0",
  "description": "A GitHub Action to automatically discover and execute Google Apps Script test functions",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "lint": "eslint src __tests__ --ext .ts"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "overrides": {
    "undici": ">=6.24.0"
  }
}
